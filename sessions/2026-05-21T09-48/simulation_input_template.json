  },
  "relationships": {
    "S_to_SWRI_coefficient": 1.2,  // 안정성($S$)이 수익($SWRI$)에 미치는 영향 계수
    "Cost_sensitivity": 0.8       // 비용 민감도 (비용 변화가 $SWRI$에 미치는 영향)
  }
